PORT=3080
DOMAIN_CLIENT=http://localhost:3080
# Optional. A remotely managed Cloudflare tunnel token pins a stable https name.
# Leave empty and up.sh starts a temporary trycloudflare.com tunnel instead.
CLOUDFLARE_TUNNEL_TOKEN=
UID=1000
GID=1000

# DeepSeek is the only chat provider. OpenAI is omitted from ENDPOINTS.
ENDPOINTS=custom,agents
DEEPSEEK_API_KEY=
FIRECRAWL_API_KEY=
# v1 or v2. The running client defaults to v2.
FIRECRAWL_VERSION=v2
# SearXNG runs in this compose file. LibreChat reaches it by service name.
SEARXNG_INSTANCE_URL=http://searxng:8080
ALLOW_REGISTRATION=true

# Generate with: openssl rand -hex 32
MEILI_MASTER_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=
ADMIN_PANEL_SESSION_SECRET=
# 32 bytes, hex
CREDS_KEY=
# 16 bytes, hex
CREDS_IV=

# Phones on this network open finished pictures and videos here.
# up.sh fills this from the machine's LAN address when it is empty.
UPSCALE_PUBLIC_URL=
